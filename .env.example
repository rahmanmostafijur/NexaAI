# ---------------------------------------------------------------------------
# NexaAI Agent configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose) ------------------------------------------
POSTGRES_DB=nexa
POSTGRES_USER=nexa
POSTGRES_PASSWORD=nexa_dev_password
POSTGRES_HOST_PORT=5434
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+asyncpg://nexa:nexa_dev_password@localhost:5434/nexa

# Read-only role used exclusively by the Text-to-SQL engine.
# It is created by the migrations and granted SELECT on the `commerce` schema only.
SQL_READONLY_USER=nexa_readonly
SQL_READONLY_PASSWORD=change-me-readonly-password

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@nexa.local
ADMIN_PASSWORD=ChangeMe123!
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM (any OpenAI-compatible Chat Completions API) ----------------------
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1                 LLM_MODEL=gpt-4o-mini
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=<provider/model>
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1 (or http://ollama:11434/v1 in compose)  LLM_MODEL=qwen2.5:7b-instruct
LLM_PROVIDER=openai_compatible     # openai_compatible | none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_JSON_MODE=true                 # send response_format=json_object for structured calls
LLM_REASONING_EFFORT=               # reasoning models (e.g. gpt-oss on Groq): low | medium | high; empty = not sent

# --- Embeddings ---------------------------------------------------------------
# fastembed runs a multilingual model locally (no API key, ~220 MB download on first use).
EMBEDDING_PROVIDER=fastembed       # fastembed | openai_compatible
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384            # must match the model; changing it requires a fresh database
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Text-to-SQL safety -------------------------------------------------------
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=200
SQL_MAX_CORRECTION_ATTEMPTS=2

# --- RAG ------------------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_RERANKER=none                  # none | llm
MAX_UPLOAD_MB=10

# --- Agent ----------------------------------------------------------------------
ROUTER_CLARIFY_THRESHOLD=0.40
CONTEXT_MAX_MESSAGES=8

# --- Rate limits (per minute) ---------------------------------------------------
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# Seed demo database + knowledge base when the backend container starts (idempotent).
SEED_ON_STARTUP=true
